APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=pusher
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ============================================
# INTEGRATIONS ARE NOT CONFIGURED HERE ANY MORE
# ============================================
# Facebook / Instagram (Meta), YouTube, X, LinkedIn, OpenAI and Ollama credentials are stored
# encrypted in the database and managed by the super admin under  Admin -> Integrations.
# Organizations can be allowed to register their own apps (Settings -> Integrations).
#
# Migrating an existing install?  php artisan saas:import-env   (see SAAS_GUIDE.md)

# ============================================
# AI DEFAULTS (only used when nothing is saved in Admin -> Integrations)
# ============================================
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:2b
OLLAMA_TIMEOUT=120
KB_EMBEDDING_MODEL=nomic-embed-text
OPENAI_API_KEY=

# ============================================
# OPTIONAL: real-time dashboard updates (Pusher). The app works without them.
# ============================================
PUSHER_APP_ID=2164474
PUSHER_APP_KEY=87c3ee78e2da7217f37e887c3ee78e2da7217f37e
